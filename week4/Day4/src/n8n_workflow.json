{
  "name": "RealEstate Hub Voice Agent - Booking Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-agent/booking",
        "responseMode": "responseNode"
      },
      "id": "webhook-call-received",
      "name": "1. Call Received (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "notes": "Entry point: the voice agent (LangGraph, Day 5) POSTs here once a caller's intent + slots are captured."
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true},
          "conditions": [
            {"leftValue": "={{$json.intent}}", "rightValue": "buyer", "operator": {"type": "string", "operation": "equals"}}
          ]
        }
      },
      "id": "intent-router",
      "name": "2. Intent Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [420, 300],
      "notes": "Routes buyer / rental / investment / reschedule / cancel to the matching branch. Simplified to one branch here for readability -- full graph has one output per intent."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.PROPERTY_API_URL}}/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "city", "value": "={{$json.city}}"},
            {"name": "max_price", "value": "={{$json.budget}}"},
            {"name": "min_bedrooms", "value": "={{$json.bedrooms}}"}
          ]
        },
        "options": {"timeout": 5000}
      },
      "id": "property-match",
      "name": "3. Property Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "notes": "Calls the Day 2 retriever (structured_search) exposed as a small HTTP wrapper. Times out after 5s -> falls through to error branch."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APPOINTMENTS_API_URL}}/book",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "property_id", "value": "={{$json.property_id}}"},
            {"name": "client_name", "value": "={{$json.client_name}}"},
            {"name": "client_phone", "value": "={{$json.client_phone}}"},
            {"name": "employee_name", "value": "={{$json.agent}}"},
            {"name": "scheduled_at", "value": "={{$json.scheduled_at}}"}
          ]
        },
        "options": {"timeout": 5000}
      },
      "id": "appointment-book",
      "name": "4. Appointment (book + availability check)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300],
      "notes": "Wraps appointments.py's book_appointment(), which refuses overlapping slots at the data layer -- 'never book unavailable slots' enforced here, not hoped for."
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": "primary",
        "start": "={{$json.scheduled_at}}",
        "end": "={{$json.scheduled_at_plus_30min}}",
        "summary": "=Property Visit: {{$json.client_name}} x {{$json.agent}}"
      },
      "id": "calendar-create",
      "name": "5. Google Calendar - Create Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1080, 220],
      "notes": "Uses n8n's built-in Google Calendar node + OAuth credential (set up once in n8n's credential manager, not per-workflow)."
    },
    {
      "parameters": {
        "maxTries": 3,
        "waitBetweenTries": 1000
      },
      "id": "calendar-retry",
      "name": "5b. Retry on Failure (Calendar)",
      "type": "n8n-nodes-base.retryOnFail",
      "typeVersion": 1,
      "position": [1080, 380],
      "notes": "Task 4 requirement: handle failures and retries. 3 attempts, 1s apart, before falling to the error-log branch."
    },
    {
      "parameters": {
        "sendTo": "={{$json.agent_email}}",
        "subject": "=New visit booked: {{$json.client_name}} - {{$json.scheduled_at}}",
        "message": "=Client: {{$json.client_name}} ({{$json.client_phone}})\nProperty: {{$json.property_summary}}\nTime: {{$json.scheduled_at}}"
      },
      "id": "email-notify",
      "name": "6. Gmail - Notify Employee",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1300, 300],
      "notes": "Uses n8n's built-in Gmail node + OAuth credential. Does not block the booking if it fails -- see error branch."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CRM_API_URL}}/log_call",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "call_id", "value": "={{$json.call_id}}"},
            {"name": "outcome", "value": "booked"},
            {"name": "preferences", "value": "={{JSON.stringify($json.slots)}}"}
          ]
        }
      },
      "id": "crm-update",
      "name": "7. CRM Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 300],
      "notes": "Always runs, even if Calendar/Email degraded above -- our own DB should never silently lose a booking record."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"status\": \"booked\", \"appointment_id\": $json.appointment_id} }}"
      },
      "id": "respond-success",
      "name": "8. Respond to Voice Agent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [1740, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ALERTS_WEBHOOK_URL}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "text", "value": "=Booking workflow step failed for call {{$json.call_id}}: {{$json.error}}"}
          ]
        }
      },
      "id": "error-alert",
      "name": "Error Branch: Alert + Log (does not lose the booking)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 540],
      "notes": "Any node's failure output routes here -- posts to a Slack/monitoring webhook and still lets CRM Update run, so a Calendar/Email hiccup never means a lost appointment."
    }
  ],
  "connections": {
    "1. Call Received (Webhook)": {"main": [[{"node": "2. Intent Router", "type": "main", "index": 0}]]},
    "2. Intent Router": {"main": [[{"node": "3. Property Match", "type": "main", "index": 0}]]},
    "3. Property Match": {"main": [[{"node": "4. Appointment (book + availability check)", "type": "main", "index": 0}]]},
    "4. Appointment (book + availability check)": {"main": [[{"node": "5. Google Calendar - Create Event", "type": "main", "index": 0}]]},
    "5. Google Calendar - Create Event": {
      "main": [[{"node": "6. Gmail - Notify Employee", "type": "main", "index": 0}]],
      "error": [[{"node": "5b. Retry on Failure (Calendar)", "type": "main", "index": 0}]]
    },
    "5b. Retry on Failure (Calendar)": {
      "main": [[{"node": "6. Gmail - Notify Employee", "type": "main", "index": 0}]],
      "error": [[{"node": "Error Branch: Alert + Log (does not lose the booking)", "type": "main", "index": 0}]]
    },
    "6. Gmail - Notify Employee": {
      "main": [[{"node": "7. CRM Update", "type": "main", "index": 0}]],
      "error": [[{"node": "7. CRM Update", "type": "main", "index": 0}]]
    },
    "7. CRM Update": {"main": [[{"node": "8. Respond to Voice Agent", "type": "main", "index": 0}]]}
  },
  "meta": {"instanceId": "realestate-hub-week4-day4"}
}
